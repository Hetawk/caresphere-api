# CareSphere API Environment Configuration
# Copy this file to .env and update with your values

# ===========================================
# CORE APP SETTINGS
# ===========================================
APP_NAME="CareSphere API"
APP_VER="1.0.0"
APP_DEBUG=false

# ===========================================
# SERVER CONFIGURATION
# ===========================================
API_HOST="0.0.0.0"
API_PORT=8000
API_RELOAD=false
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_URL="mysql+pymysql://user:password@localhost:3306/caresphere"
DB_ECHO=false

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
JWT_SECRET="change-me"
JWT_ALG="HS256"
JWT_EXP=86400
JWT_REFRESH_EXP=604800
HASH_ROUNDS=12

# ===========================================
# PAGINATION / LIMITS
# ===========================================
PAGE_DEF=1
PAGE_SIZE_DEF=20
PAGE_SIZE_MAX=100
LOG_LIMIT_DEF=50
LOG_LIMIT_MAX=200

# ===========================================
# MESSAGING DEFAULTS
# ===========================================
MSG_NAME="CareSphere"
MSG_EMAIL="no-reply@caresphere.app"
MSG_PHONE="+10000000000"

# ===========================================
# EKDSEND EMAIL/SMS API
# ===========================================
# Get your API key from https://es.ekddigital.com/dashboard/api-keys
# Supports: email, sms, voice
# Built-in Templates: welcome, verification, passwordReset, apiKeyCreated, quotaWarning, deliveryFailure
# API Limits: max 50 recipients per email, max 998 chars subject line
EKDSEND_API_KEY=""
EKDSEND_API_URL="https://es.ekddigital.com/api/v1"

# ===========================================
# API CONFIGURATION
# ===========================================
# Base URL for the API (used in emails for logo links, etc.)
API_BASE_URL="https://caresphere.ekddigital.com"

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_DEMO=false
FEATURE_ANALYTICS=true
FEATURE_AUTOMATION=true

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL="info"
